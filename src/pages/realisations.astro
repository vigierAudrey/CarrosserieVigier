---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Réalisations avant / après';
const withBase = (path) => `${import.meta.env.BASE_URL}${String(path).replace(/^\//, '')}`;

const description =
  'Exemples de réparations réalisées : carrosserie, peinture et finitions premium avec un rendu soigné.';

const projects = [
  {
    title: 'Impact latéral et peinture complète',
    category: 'Carrosserie & Peinture',
    before: withBase('/images/realisations/avant-1.svg'),
    after: withBase('/images/realisations/apres-1.svg'),
  },
  {
    title: 'Redressage aile + raccord peinture',
    category: 'Débosselage & Finition',
    before: withBase('/images/realisations/avant-2.svg'),
    after: withBase('/images/realisations/apres-2.svg'),
  },
  {
    title: 'Rénovation optiques et finition',
    category: 'Rénovation & Esthétique',
    before: withBase('/images/realisations/avant-3.svg'),
    after: withBase('/images/realisations/apres-3.svg'),
  },
  {
    title: 'Restauration véhicule ancien',
    category: 'Restauration Vintage',
    before: withBase('/images/realisations/avant-4.svg'),
    after: withBase('/images/realisations/apres-4.svg'),
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero Section -->
  <section class="section realisations-hero">
    <div class="container">
      <div class="hero-content-center">
        <span class="tag premium-tag">Notre savoir-faire</span>
        <h1 class="section-title">Réalisations avant / après</h1>
        <p class="hero-lead">
          L'excellence dans chaque détail. Découvrez notre travail de précision
          à travers nos réparations les plus marquantes.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery Projects -->
  <section class="section projects-section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project, index) => (
          <article class="project-card" data-index={index}>
            <div class="project-header">
              <span class="project-category">{project.category}</span>
              <h2 class="project-title">{project.title}</h2>
            </div>
            <div class="project-images">
              <div class="project-image-wrapper before-image">
                <span class="image-label">Avant</span>
                <img
                  src={project.before}
                  alt={`Avant - ${project.title}`}
                  width="800"
                  height="600"
                  loading="lazy"
                />
              </div>
              <div class="project-divider">→</div>
              <div class="project-image-wrapper after-image">
                <span class="image-label">Après</span>
                <img
                  src={project.after}
                  alt={`Après - ${project.title}`}
                  width="800"
                  height="600"
                  loading="lazy"
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-realisations-section">
    <div class="container">
      <div class="cta-card surface premium-card">
        <div class="cta-content">
          <p class="section-kicker">Un projet similaire ?</p>
          <h2>Confiez-nous votre véhicule</h2>
          <p class="cta-text">
            Que ce soit une simple retouche ou une restauration complète,
            nous apportons le même soin à chaque intervention.
          </p>
          <div class="cta-buttons">
            <a href={withBase('/contact')} class="btn">Demander un devis</a>
            <a href={withBase('/prestations')} class="btn btn--ghost">Voir nos prestations</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Variables couleur or */
  :root {
    --gold: #d4af37;
    --gold-light: #f0d98f;
    --gold-dark: #b8941f;
  }

  /* Hero Section */
  .realisations-hero {
    background: linear-gradient(135deg, var(--bg) 0%, var(--accent-soft) 50%, var(--bg) 100%);
    text-align: center;
  }

  .hero-content-center {
    max-width: 800px;
    margin: 0 auto;
  }

  .premium-tag {
    background: linear-gradient(135deg, var(--gold-dark), var(--gold));
    color: #fff;
    border: none;
    font-weight: 600;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.3);
    display: inline-flex;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--muted);
    margin-top: 20px;
  }

  /* Projects Section */
  .projects-section {
    background: var(--bg);
  }

  .projects-grid {
    display: grid;
    gap: 56px;
  }

  .project-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--gold-dark), var(--gold), var(--gold-light));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .project-card:hover::before {
    transform: scaleX(1);
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 16px 48px rgba(15, 118, 110, 0.15);
  }

  .project-header {
    padding: 28px 32px;
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }

  .project-category {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--gold);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }

  .project-title {
    color: var(--accent-strong);
    font-size: 1.5rem;
    margin: 0;
    font-family: var(--font-serif);
  }

  .project-images {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    position: relative;
  }

  .project-image-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--bg-elev);
  }

  .image-label {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(0, 0, 0, 0.75);
    color: #fff;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 2;
    backdrop-filter: blur(8px);
  }

  .before-image .image-label {
    background: rgba(220, 38, 38, 0.85);
  }

  .after-image .image-label {
    background: rgba(22, 163, 74, 0.85);
  }

  .project-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .project-image-wrapper:hover img {
    transform: scale(1.05);
  }

  .project-divider {
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: var(--gold);
    font-weight: 700;
    padding: 0 16px;
    background: var(--bg-elev);
  }

  /* CTA Section */
  .cta-realisations-section {
    background: linear-gradient(135deg, var(--accent-soft) 0%, transparent 100%);
  }

  .cta-card {
    padding: 48px 32px;
    text-align: center;
  }

  .premium-card {
    background: linear-gradient(135deg, var(--card) 0%, var(--accent-soft) 100%);
    border: 2px solid var(--accent);
    position: relative;
  }

  .premium-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--gold-dark), var(--gold), var(--gold-light), var(--gold), var(--gold-dark));
  }

  .cta-content h2 {
    color: var(--accent-strong);
    font-size: 1.8rem;
    margin: 8px 0 16px;
  }

  .cta-text {
    font-size: 1.05rem;
    color: var(--muted);
    margin-bottom: 28px;
    line-height: 1.7;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  /* Responsive - Tablette */
  @media (min-width: 768px) {
    .project-images {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .project-divider {
      display: flex;
    }

    .projects-grid {
      gap: 64px;
    }
  }

  /* Responsive - Desktop */
  @media (min-width: 1024px) {
    .project-header {
      padding: 32px 40px;
    }

    .cta-card {
      padding: 56px 64px;
    }

    .projects-grid {
      gap: 72px;
    }
  }

  /* Mode sombre */
  :root[data-theme="dark"] .premium-card {
    background: linear-gradient(135deg, var(--card) 0%, rgba(212, 175, 55, 0.05) 100%);
  }

  :root[data-theme="dark"] .image-label {
    backdrop-filter: blur(12px);
  }

  :root[data-theme="dark"] .before-image .image-label {
    background: rgba(220, 38, 38, 0.95);
  }

  :root[data-theme="dark"] .after-image .image-label {
    background: rgba(22, 163, 74, 0.95);
  }
</style>
